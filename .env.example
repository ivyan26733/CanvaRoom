# Local API service; values are validated on startup.
SERVER_HOST=127.0.0.1
SERVER_PORT=4000

# Set a long random value for any non-local deployment.
AUTH_SECRET=replace-with-a-long-random-secret

# Postgres for accounts and boards (the Neon integration sets DATABASE_URL).
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Redis for presence, rate limits, and cross-instance realtime fan-out
# (the Upstash integration sets REDIS_URL / KV_URL). Without either database,
# the API keeps boards in memory and saves them to apps/server/data/state.json.
# REDIS_URL=rediss://default:password@host:6379

# Private Vercel Blob store for board images. Without it, images are saved to
# apps/server/data/images (local development only).
# BLOB_READ_WRITE_TOKEN=

# Optional TURN relay for voice calls between people on strict networks.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Razorpay Standard Checkout. The secret stays on the server; the key ID is
# sent to the browser with each order. Use rzp_test_ keys until live mode.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Webhook (Razorpay Dashboard → Webhooks): URL https://<site>/api/billing/webhook,
# events payment.captured, order.paid and refund.processed, and this same secret.
# RAZORPAY_WEBHOOK_SECRET=

# PayPal Checkout for buyers outside India (developer.paypal.com → Apps &
# Credentials). PAYPAL_MODE=sandbox (the default) uses the sandbox app and
# lets only PAYPAL_SANDBOX_TESTERS (comma-separated emails) pay; live takes
# real money from everyone. Until PayPal is available to a visitor, they keep
# Razorpay. India always pays in rupees through Razorpay.
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_SANDBOX_CLIENT_ID=
# PAYPAL_SANDBOX_CLIENT_SECRET=
# PAYPAL_SANDBOX_TESTERS=you@example.com
# The webhook for the current mode: URL https://<site>/api/billing/paypal/webhook,
# events PAYMENT.CAPTURE.COMPLETED, .REFUNDED and .REVERSED. Its ID, not a secret.
# PAYPAL_WEBHOOK_ID=

# The 3, 6 and 12-month plans are in apps/server/src/plans.ts. This is only
# the days a one-month order from before them still buys.
# BILLING_PASS_DAYS=30

# Vercel sends it on the daily cron that emails Premium renewal reminders
# (vercel.json). Without it the cron route refuses every call.
# CRON_SECRET=

# Email to any address over SMTP, e.g. Gmail with an App Password. Takes
# precedence over Resend for sign-up codes, password reset and feedback.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=canvacollabroom@gmail.com
# SMTP_PASS=
# SMTP_FROM=CanvaRoom <canvacollabroom@gmail.com>

# Feedback from the site is stored and, with RESEND_API_KEY set, emailed here.
# Resend's shared sender reaches only the Resend account's own address, so
# password reset email stays off until MAIL_FROM uses a verified domain.
# RESEND_API_KEY=
# MAIL_FROM=CanvaRoom <hello@your-domain.com>
# FEEDBACK_TO=ivyan26733@gmail.com

# Cloudflare Realtime SFU for voice calls. The token stays on the server, which
# makes every Cloudflare call; without these, calls fall back to peer-to-peer.
# CF_REALTIME_APP_ID=
# CF_REALTIME_APP_TOKEN=
