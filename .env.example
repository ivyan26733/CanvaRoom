# Local API service; values are validated on startup.
SERVER_HOST=127.0.0.1
SERVER_PORT=4000

# Set a long random value for any non-local deployment.
AUTH_SECRET=replace-with-a-long-random-secret

# Postgres for accounts and boards (the Neon integration sets DATABASE_URL).
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Redis for presence, rate limits, and cross-instance realtime fan-out
# (the Upstash integration sets REDIS_URL / KV_URL). Without either database,
# the API keeps boards in memory and saves them to apps/server/data/state.json.
# REDIS_URL=rediss://default:password@host:6379

# Private Vercel Blob store for board images. Without it, images are saved to
# apps/server/data/images (local development only).
# BLOB_READ_WRITE_TOKEN=

# Optional TURN relay for voice calls between people on strict networks.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Razorpay Standard Checkout. The secret stays on the server; the key ID is
# sent to the browser with each order. Use rzp_test_ keys until live mode.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# The paid pass, in the currency's smallest unit (cents for USD). The list
# price is shown struck through next to the price charged.
# BILLING_CURRENCY=USD
# BILLING_PRICE_MINOR=1199
# BILLING_LIST_PRICE_MINOR=1599
# BILLING_PASS_DAYS=30
