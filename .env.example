# Local API service; values are validated on startup.
SERVER_HOST=127.0.0.1
SERVER_PORT=4000

# Set a long random value for any non-local deployment.
AUTH_SECRET=replace-with-a-long-random-secret

# Redis for boards and cross-instance realtime fan-out. Required on Vercel
# (the Upstash integration sets REDIS_URL / KV_URL). Without it, the API keeps
# boards in memory and saves them to apps/server/data/state.json.
# REDIS_URL=rediss://default:password@host:6379

# Optional TURN relay for voice calls between people on strict networks.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=
