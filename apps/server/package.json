{
  "name": "@collabboard/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "start": "node --import tsx src/index.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:import-redis": "node --import tsx scripts/import-redis.ts",
    "paypal:webhook": "node --import tsx scripts/paypal-webhook.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "ws": "^8.22.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
